# Port the addon server runs on (Default: 7860)
PORT=7860

# Public URL of your deployed addon (e.g., https://stremio-tg.yourdomain.com)
ADDON_URL=http://localhost:7860

# Optional API Key to secure your addon (e.g., Gvi4ShwFyYz...)
API_KEY=

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Telegram Bot Token from @BotFather (required if USER_SESSION_STRING is not set)
BOT_TOKEN=

# Optional extra bot tokens (one per line or comma separated; BOT_TOKEN_2,
# BOT_TOKEN_3, ... also work). Every bot must be an ADMIN of your media
# channels. Bots take part in the streaming rotation next to the user
# sessions, so each bot adds another FloodWait budget.
BOT_TOKENS=

# true  = bots carry stream chunks together with the user sessions (default)
# false = bots are only a fallback when every user session fails
TG_BOT_STREAMING=true

# Primary Telegram User Session String (required for large files)
USER_SESSION_STRING=

# Optional extra user session strings for streaming rotation. Put one per line
# or separate them with commas. Each account downloads a share of the 1 MiB
# chunks, which spreads FloodWait/rate limits and helps very large split files.
# You can also use USER_SESSION_STRING_2, USER_SESSION_STRING_3, ...
# NOTE: multiple sessions do not bypass Telegram's per-file upload size cap.
USER_SESSION_STRINGS=

# How to use the credentials above:
#   auto = use all session strings and bot tokens for streaming
#   user = session strings only (bot token ignored)
#   bot  = bot tokens only (no channel history search)
TG_AUTH_MODE=auto

# Optional guard for bot-only setups (MTProto bots can read large files, so it is
# off by default). Files larger than this many MB are refused. 0 disables it.
BOT_FILE_LIMIT_MB=0

# Streaming engine: total 1 MiB chunks fetched ahead per stream (2-8 recommended;
# with multiple sessions, 6-8 keeps more requests in flight across accounts)
TG_STREAM_PREFETCH=4
TG_STREAM_MAX_RETRIES=3

# Search anti-flood (advanced). Raise the interval if Telegram starts throttling.
TG_SEARCH_CONCURRENCY=2
TG_SEARCH_MIN_INTERVAL=0.35
TG_FLOOD_WAIT_MAX=120

# Comma-separated list of Telegram Channel IDs to index (e.g., -100xxxxxxxxxx, -100yyyyyyyyyy)
TELEGRAM_CHANNEL_ID=

# Optional: Channel ID to send play/seek/stop logs to (e.g., -100zzzzzzzzzz).
# Logs include your region time, date, year, play count and progress %.
LOG_CHANNEL_ID=

# Optional: Timezone for logging (e.g., Asia/Kolkata, UTC). Defaults to UTC.
TIMEZONE=UTC

# Optional: Cache duration in seconds for search queries (Default: 1800)
CACHE_TTL=1800

# --- Configuration Wizard (web setup at /configure) ---
# Password that unlocks the wizard. If empty, the first visitor can claim it.
CONFIG_PASSWORD=

# --- Posters / genres / localization (TMDB) ---
# Free API key from https://www.themoviedb.org/settings/api (optional; falls back to Cinemeta)
TMDB_API_KEY=
# Language for posters/titles, applied as TMDB language= param (e.g. hi-IN, es-ES). Default: en-US
TMDB_LANGUAGE=en-US

# --- Per-IP rate limiting (enable when sharing publicly) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60
RATE_LIMIT_STREAM_REQUESTS=600
# Token-bucket bursts (a player can burst after a seek without waiting)
RATE_LIMIT_BURST=30
RATE_LIMIT_STREAM_BURST=120
# Simultaneous stream connections per IP (0 disables the cap)
RATE_LIMIT_STREAM_CONCURRENCY=8
# Set false if the app is exposed directly (not behind a reverse proxy),
# otherwise clients can spoof X-Forwarded-For.
TRUST_PROXY_HEADERS=true

# --- Watch history / play logs ---
# Log start/seek/stop events (builds Continue Watching + Telegram logs). Default: true
WATCH_LOG_EVENTS=true

# Directory for the SQLite cache + wizard config (mount as volume to persist)
DATA_DIR=./data
